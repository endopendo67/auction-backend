# Сервер
PORT=3000
NODE_ENV=development

# MongoDB (нужен replica set для транзакций)
MONGODB_URI=mongodb://localhost:27017/auction_db

# Redis (опционально, для кэширования)
REDIS_URI=redis://localhost:6379

# Настройки аукциона
DEFAULT_ROUND_DURATION_MS=300000
ANTI_SNIPE_THRESHOLD_MS=30000
ANTI_SNIPE_EXTENSION_MS=60000
MIN_BID_INCREMENT=10

# Настройки ставок
# Rate limiting: 0 = отключено (для стресс-тестов)
BID_RATE_LIMIT_REQUESTS=0
BID_RATE_LIMIT_WINDOW_SEC=5
# Retry при WriteConflict
BID_MAX_RETRY_ATTEMPTS=10

# Логирование
LOG_LEVEL=debug

# Куки (для локального тестирования без HTTPS)
COOKIE_SECURE=false
