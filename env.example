# ===========================================
# Auction Backend Configuration
# ===========================================
# Скопируйте этот файл в .env и измените значения

# === Сервер ===
PORT=3000
NODE_ENV=development
# Для production используйте: NODE_ENV=production

# === MongoDB ===
# Для локальной разработки (без Docker):
MONGODB_URI=mongodb://localhost:27017/auction_db?directConnection=true
# Docker Compose автоматически переопределяет это значение

# === Redis ===
REDIS_URI=redis://localhost:6379
# Docker Compose автоматически переопределяет это значение

# === Настройки аукциона ===
DEFAULT_ROUND_DURATION_MS=300000
ANTI_SNIPE_THRESHOLD_MS=30000
ANTI_SNIPE_EXTENSION_MS=60000
MIN_BID_INCREMENT=10

# === Настройки ставок ===
# Rate limiting: 0 = отключено (для стресс-тестов)
BID_RATE_LIMIT_REQUESTS=0
BID_RATE_LIMIT_WINDOW_SEC=5
# Retry при WriteConflict
BID_MAX_RETRY_ATTEMPTS=10

# === Логирование ===
# Уровни: error, warn, info, debug
LOG_LEVEL=debug

# === Куки ===
# Для HTTPS установите true
COOKIE_SECURE=false

# === Docker Compose (опционально) ===
# Порты для docker-compose.yml (если заняты стандартные)
APP_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
